# This build holds no Cloudflare credentials: DNS and Email Routing are yours to
# manage (see docs/manual-setup.md). Nothing below is required to receive mail.

# Optional: lets the admin dashboard trigger the GitHub update workflow.
# GITHUB_UPDATE_TOKEN=github...rite
# GITHUB_UPDATE_REPO=owner/repo
# GITHUB_UPDATE_REF=main

# Optional: Cloudflare Turnstile on the first-run registration form.
# TURNSTILE_SECRET_KEY=

# The Worker uses the AI binding in wrangler.jsonc. Override its chat/draft model
# if needed (the default is a US-origin model on Workers AI).
# AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
